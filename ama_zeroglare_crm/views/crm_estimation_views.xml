<odoo>

    <record id="crm_estimation_view_tree" model="ir.ui.view">
        <field name="name">Estimation Tree View</field>
        <field name="model">crm.estimation</field>
        <field name="arch" type="xml">
            <list string="Estimation" js_class="button_in_tree">
                <field name="name"/>
                <field name="currency_id"/>
                <field name="shipping_mode_id"/>
            </list>
        </field>
    </record>

    <record id="crm_estimation_view_form" model="ir.ui.view">
        <field name="name">Estimation Form View</field>
        <field name="model">crm.estimation</field>
        <field name="arch" type="xml">
            <form string="Estimation">
                <sheet>
                    <label for="name"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" required="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="currency_id"/>
                        </group>
                        <group>
                            <field name="shipping_mode_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="boq" string="Bill of Quantities">
                            <field name="boq_ids">
                                <list editable="bottom">
                                    <field name="description"/>
                                    <field name="qty"/>
                                    <field name="unit_id"/>
                                    <field name="cost"/>
                                    <field name="total"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>

        </field>
    </record>


</odoo>