<odoo>

    <record id="shipping_mode_view_tree" model="ir.ui.view">
        <field name="name">Shipping Mode Tree View</field>
        <field name="model">shipping.mode</field>
        <field name="arch" type="xml">
            <list string="Shipping Mode">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="shipping_mode_view_form" model="ir.ui.view">
        <field name="name">Shipping Mode Form View</field>
        <field name="model">shipping.mode</field>
        <field name="arch" type="xml">
            <form string="Shipping Mode">
                <sheet>
                    <label for="name"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" required="1"/>
                        </h1>
                    </div>
                </sheet>
                <chatter/>
            </form>

        </field>
    </record>

</odoo>


